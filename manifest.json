{
  "manifest_version": 2,
  "name": "JP Spam Reporter Enhanced",
  "version": "2.4.17.0",
  "description": "Thunderbirdで迷惑メール・フィッシングメールを検出し、日本の報告機関に報告（統合版）。VirusTotal、Google Safe Browsing、PhishTank対応。危険検出時に自動レポート作成",
  "author": "Masatoshi Ishikawa",
  "applications": {
    "gecko": {
      "id": "jp-spam-reporter-enhanced@example.com",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesMove",
    "messagesDelete",
    "compose",
    "storage",
    "tabs",
    "notifications",
    "accountsRead",
    "https://www.virustotal.com/*",
    "https://safebrowsing.googleapis.com/*",
    "https://checkurl.phishtank.com/*"
  ],
  "icons": {
    "16": "icons/jp-spam-reporter-16.png",
    "32": "icons/jp-spam-reporter-32.png",
    "48": "icons/jp-spam-reporter-48.png",
    "128": "icons/jp-spam-reporter-128.png"
  },
  "background": {
    "scripts": [
      "utils/url.js",
      "utils/sanitize.js",
      "utils/auth.js",
      "utils/notify.js",
      "utils/spinner.js",
      "utils/phishing-detect.js",
      "background/providers/gsb.js",
      "background/providers/pt.js",
      "background/providers/vt.js",
      "background/extract.js",
      "background/api.js",
      "background/bridge.js",
      "background/content-handler.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "message_display_action": {
    "default_title": "JP Spam Reporter",
    "default_popup": "ui/report.html",
    "default_icon": {
      "16": "icons/jp-spam-reporter-16.png",
      "32": "icons/jp-spam-reporter-32.png",
      "48": "icons/jp-spam-reporter-48.png",
      "128": "icons/jp-spam-reporter-128.png"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src https://www.virustotal.com https://safebrowsing.googleapis.com https://checkurl.phishtank.com;"
}
